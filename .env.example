# Copy to .env for local development. Never commit real values.

# Postgres connection string (Supabase: Project Settings > Database > Connection string, "Session pooler").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prepup

# Your Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# Publishable (anon) key. Safe to expose in the browser; used only by the OAuth consent page.
SUPABASE_PUBLISHABLE_KEY=

# The public HTTPS URL of this API, e.g. https://prepup-api.fly.dev (no trailing slash).
PUBLIC_URL=http://localhost:8080

# "supabase" (default, real tokens) or "dev" (trusts an x-dev-user-id header; local only, refused in production).
AUTH_MODE=dev

PORT=8080
DB_POOL_MAX=5

# Social sign-in buttons to show (each must also be enabled in Supabase): "google", "github" or "google,github".
AUTH_PROVIDERS=
