# Copy to .env for local development. Never commit real values.

# Postgres connection string (Supabase: Project Settings > Database > Connection string, "Session pooler").
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prepup

# Your Supabase project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=

# Publishable (anon) key. Safe to expose in the browser; used only by the OAuth consent page.
SUPABASE_PUBLISHABLE_KEY=

# The public HTTPS URL of this API, e.g. https://prepup-api.fly.dev (no trailing slash).
PUBLIC_URL=http://localhost:8080

# "supabase" (default, real tokens) or "dev" (trusts an x-dev-user-id header; local only, refused in production).
AUTH_MODE=dev

PORT=8080
DB_POOL_MAX=5

# Social sign-in buttons to show (each must also be enabled in Supabase): "google", "github" or "google,github".
AUTH_PROVIDERS=

# The `aud` claim tokens must carry. Supabase's default for signed-in users is "authenticated".
AUTH_AUDIENCE=authenticated

# Per-user limits that protect a shared host: requests per minute and per day, and topics per deck (max 500).
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_PER_DAY=5000
MAX_TOPICS_PER_USER=500

# The public costs page (#/costs). What this copy costs you a month in US dollars, and the database size your plan allows.
HOSTING_COST_PER_MONTH=0
DATABASE_LIMIT_MB=500
# A link for people who want to chip in (Buy Me a Coffee, GitHub Sponsors...). Must be https. Empty hides it.
SUPPORT_URL=
# Where the code lives; shown as "Source". Change it if you run a fork.
SOURCE_URL=https://github.com/Solivagant14/prepup
